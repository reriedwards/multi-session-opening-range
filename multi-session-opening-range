// @version=6
indicator("Multi-Session Opening Range", overlay=true, max_lines_count=500)

// --- Global Settings ---
lineWidthInput    = input.int(1, title="Line Thickness", minval=1, group="Global Settings")

// --- New York Session Inputs ---
enableNY         = input.bool(true, title="Enable New York Session", group="New York Session")
nyStartHour      = input.int(9, title="Start Hour", minval=0, maxval=23, group="New York Session")
nyStartMin       = input.int(27, title="Start Minute", minval=0, maxval=59, group="New York Session")
nyRangeMinutes   = input.int(3, title="Opening Range (Minutes)", minval=1, group="New York Session")
nyExtendMinutes  = input.int(393, title="Extension Time (Minutes)", minval=1, group="New York Session")
nyHighColor      = input.color(color.blue, title="High Line Color", group="New York Session")
nyLowColor       = input.color(color.red, title="Low Line Color", group="New York Session")
nyBreakHighColor = input.color(color.blue, title="Upper Breakout Line Color", group="New York Session")
nyBreakLowColor  = input.color(color.red, title="Lower Breakout Line Color", group="New York Session")
nyExtHighColor   = input.color(color.blue, title="Upper Half Range Line Color", group="New York Session")
nyExtLowColor    = input.color(color.red, title="Lower Half Range Line Color", group="New York Session")

// --- London Session Inputs ---
enableLDN         = input.bool(false, title="Enable London Session", group="London Session")
ldnStartHour      = input.int(8, title="Start Hour", minval=0, maxval=23, group="London Session")
ldnStartMin       = input.int(27, title="Start Minute", minval=0, maxval=59, group="London Session")
ldnRangeMinutes   = input.int(3, title="Opening Range (Minutes)", minval=1, group="London Session")
ldnExtendMinutes  = input.int(300, title="Extension Time (Minutes)", minval=1, group="London Session")
ldnHighColor      = input.color(color.blue, title="High Line Color", group="London Session")
ldnLowColor       = input.color(color.red, title="Low Line Color", group="London Session")
ldnBreakHighColor = input.color(color.blue, title="Upper Breakout Line Color", group="London Session")
ldnBreakLowColor  = input.color(color.red, title="Lower Breakout Line Color", group="London Session")
ldnExtHighColor   = input.color(color.blue, title="Upper Half Range Line Color", group="London Session")
ldnExtLowColor    = input.color(color.red, title="Lower Half Range Line Color", group="London Session")

// --- Tokyo Session Inputs ---
enableTKO         = input.bool(true, title="Enable Tokyo Session", group="Tokyo Session")
tkoStartHour      = input.int(8, title="Start Hour", minval=0, maxval=23, group="Tokyo Session")
tkoStartMin       = input.int(57, title="Start Minute", minval=0, maxval=59, group="Tokyo Session")
tkoRangeMinutes   = input.int(3, title="Opening Range (Minutes)", minval=1, group="Tokyo Session")
tkoExtendMinutes  = input.int(362, title="Extension Time (Minutes)", minval=1, group="Tokyo Session")
tkoHighColor      = input.color(color.blue, title="High Line Color", group="Tokyo Session")
tkoLowColor       = input.color(color.red, title="Low Line Color", group="Tokyo Session")
tkoBreakHighColor = input.color(color.blue, title="Upper Breakout Line Color", group="Tokyo Session")
tkoBreakLowColor  = input.color(color.red, title="Lower Breakout Line Color", group="Tokyo Session")
tkoExtHighColor   = input.color(color.blue, title="Upper Half Range Line Color", group="Tokyo Session")
tkoExtLowColor    = input.color(color.red, title="Lower Half Range Line Color", group="Tokyo Session")

// --- Opening Range Logic Function (Returns High/Low boundaries) ---
getOpeningRange(bool enabled, string tz, int startHour, int startMin, int rangeMins, int extendMins, color hiColor, color loColor, color breakHiColor, color breakLoColor, color extHiColor, color extLowColor, int thickness) =>
    var float maxHigh   = na
    var float minLow    = na
    var bool linesDrawn = false

    // Track breakouts and extension line crossings independently
    var bool breakHighDrawn = false
    var bool breakLowDrawn  = false
    var bool upperExtDrawn  = false
    var bool lowerExtDrawn  = false
    
    // Maintain computed levels across bars
    var float upperExtLevel = na
    var float lowerExtLevel = na

    if enabled
        int currentYear  = year(time, tz)
        int currentMonth = month(time, tz)
        int currentDay   = dayofmonth(time, tz)

        int sessionStartMs = timestamp(tz, currentYear, currentMonth, currentDay, startHour, startMin, 0)
        int rangeEndMs     = sessionStartMs + (rangeMins * 60 * 1000)
        int extensionMs    = extendMins * 60 * 1000
        int futureTime     = sessionStartMs + extensionMs

        bool isNewSession = (time >= sessionStartMs) and (time[1] < sessionStartMs or na(time[1]))

        if isNewSession
            maxHigh        := high
            minLow         := low
            linesDrawn     := false
            breakHighDrawn := false
            breakLowDrawn  := false
            upperExtDrawn  := false
            lowerExtDrawn  := false
            upperExtLevel  := na
            lowerExtLevel  := na

        else if (time >= sessionStartMs) and (time < rangeEndMs)
            maxHigh    := math.max(maxHigh, high)
            minLow     := math.min(minLow, low)

        bool timeWindowPassed = (time >= rangeEndMs) or (time + (timeframe.multiplier * 60 * 1000) > rangeEndMs)
        bool triggerDrawing   = timeWindowPassed and not linesDrawn and not na(maxHigh)

        if triggerDrawing
            // Calculate range size and exact half-range expansion levels
            float rangeSize = maxHigh - minLow
            upperExtLevel  := maxHigh + (rangeSize * 0.5)
            lowerExtLevel  := minLow - (rangeSize * 0.5)

            // Draw Core Boundary Lines
            line.new(x1=sessionStartMs, y1=maxHigh, x2=futureTime, y2=maxHigh, xloc=xloc.bar_time, color=hiColor, width=thickness)
            line.new(x1=sessionStartMs, y1=minLow, x2=futureTime, y2=minLow, xloc=xloc.bar_time, color=loColor, width=thickness)

            linesDrawn := true

        // Real-Time Processing Window (Active after range forms, before extension limit)
        if linesDrawn and time >= rangeEndMs and time < futureTime
            
            // --- UPPER SIDE MUTUAL EXCLUSION ---
            // 1. Check real-time wick touch for Mid-Range line FIRST (x1 is set to current time of cross)
            if not upperExtDrawn and not breakHighDrawn and high >= upperExtLevel
                line.new(x1=time, y1=upperExtLevel, x2=futureTime, y2=upperExtLevel, xloc=xloc.bar_time, color=extHiColor, width=thickness, style=line.style_solid)
                upperExtDrawn := true
                
            // 2. Check confirmed candle close for Breakout Line SECOND
            if barstate.isconfirmed and not breakHighDrawn and not upperExtDrawn and close > maxHigh
                line.new(x1=time_close, y1=close, x2=futureTime, y2=close, xloc=xloc.bar_time, color=breakHiColor, width=thickness)
                breakHighDrawn := true


            // --- LOWER SIDE MUTUAL EXCLUSION ---
            // 1. Check real-time wick touch for Mid-Range line FIRST (x1 is set to current time of cross)
            if not lowerExtDrawn and not breakLowDrawn and low <= lowerExtLevel
                line.new(x1=time, y1=lowerExtLevel, x2=futureTime, y2=lowerExtLevel, xloc=xloc.bar_time, color=extLowColor, width=thickness, style=line.style_solid)
                lowerExtDrawn := true

            // 2. Check confirmed candle close for Breakout Line SECOND
            if barstate.isconfirmed and not breakLowDrawn and not lowerExtDrawn and close < minLow
                line.new(x1=time_close, y1=close, x2=futureTime, y2=close, xloc=xloc.bar_time, color=breakLoColor, width=thickness)
                breakLowDrawn := true

        // Clear tracking values once past extension window limit
        if (time >= futureTime)
            maxHigh := na
            minLow := na

    [maxHigh, minLow]

// --- Execute Sessions and Capture Boundaries ---
[nyHigh, nyLow]   = getOpeningRange(enableNY, "America/New_York", nyStartHour, nyStartMin, nyRangeMinutes, nyExtendMinutes, nyHighColor, nyLowColor, nyBreakHighColor, nyBreakLowColor, nyExtHighColor, nyExtLowColor, lineWidthInput)
[ldnHigh, ldnLow] = getOpeningRange(enableLDN, "Europe/London", ldnStartHour, ldnStartMin, ldnRangeMinutes, ldnExtendMinutes, ldnHighColor, ldnLowColor, ldnBreakHighColor, ldnBreakLowColor, ldnExtHighColor, ldnExtLowColor, lineWidthInput)
[tkoHigh, tkoLow] = getOpeningRange(enableTKO, "Asia/Tokyo", tkoStartHour, tkoStartMin, tkoRangeMinutes, tkoExtendMinutes, tkoHighColor, tkoLowColor, tkoBreakHighColor, tkoBreakLowColor, tkoExtHighColor, tkoExtLowColor, lineWidthInput)
