// @version=6
indicator("Multi-Session Opening Range", overlay=true, max_lines_count=500)

// ─────────────────────────────────────────────────────────────
// 1. GLOBAL SETTINGS
// ─────────────────────────────────────────────────────────────

const string GLOBAL = "Global Settings"

lineWidth = input.int(1, "Line Thickness", minval=1, group=GLOBAL)
continuationTicks = input.int(50, "Continuation Target (Ticks)", minval=1, group=GLOBAL)
upperContinuationColor = input.color(color.blue, "Upper Continuation Color", group=GLOBAL)
lowerContinuationColor = input.color(color.red, "Lower Continuation Color", group=GLOBAL)

// ─────────────────────────────────────────────────────────────
// 2. SESSION SETTINGS
// ─────────────────────────────────────────────────────────────

const string NY = "New York Session"

nyEnabled = input.bool(true, "Enable Session", group=NY)
nyHour = input.int(9, "Start Hour", minval=0, maxval=23, group=NY)
nyMinute = input.int(27, "Start Minute", minval=0, maxval=59, group=NY)
nyRange = input.int(3, "Opening Range (Minutes)", minval=1, group=NY)
nyExtension = input.int(392, "Extension Time (Minutes)", minval=1, group=NY)
nyHighColor = input.color(#666666, "High Line Color", group=NY)
nyLowColor = input.color(#666666, "Low Line Color", group=NY)
nyBreakHighColor = input.color(#666666, "Upper Breakout Color", group=NY)
nyBreakLowColor = input.color(#666666, "Lower Breakout Color", group=NY)

const string LDN = "London Session"

ldnEnabled = input.bool(false, "Enable Session", group=LDN)
ldnHour = input.int(8, "Start Hour", minval=0, maxval=23, group=LDN)
ldnMinute = input.int(27, "Start Minute", minval=0, maxval=59, group=LDN)
ldnRange = input.int(3, "Opening Range (Minutes)", minval=1, group=LDN)
ldnExtension = input.int(300, "Extension Time (Minutes)", minval=1, group=LDN)
ldnHighColor = input.color(#666666, "High Line Color", group=LDN)
ldnLowColor = input.color(#666666, "Low Line Color", group=LDN)
ldnBreakHighColor = input.color(#666666, "Upper Breakout Color", group=LDN)
ldnBreakLowColor = input.color(#666666, "Lower Breakout Color", group=LDN)

const string TKO = "Tokyo Session"

tkoEnabled = input.bool(true, "Enable Session", group=TKO)
tkoHour = input.int(8, "Start Hour", minval=0, maxval=23, group=TKO)
tkoMinute = input.int(57, "Start Minute", minval=0, maxval=59, group=TKO)
tkoRange = input.int(3, "Opening Range (Minutes)", minval=1, group=TKO)
tkoExtension = input.int(362, "Extension Time (Minutes)", minval=1, group=TKO)
tkoHighColor = input.color(#666666, "High Line Color", group=TKO)
tkoLowColor = input.color(#666666, "Low Line Color", group=TKO)
tkoBreakHighColor = input.color(#666666, "Upper Breakout Color", group=TKO)
tkoBreakLowColor = input.color(#666666, "Lower Breakout Color", group=TKO)

// ─────────────────────────────────────────────────────────────
// 3. DRAWING HELPERS
// ─────────────────────────────────────────────────────────────

drawLine(int fromTime, int toTime, float price, color lineColor) =>
    line.new(fromTime, price, toTime, price, xloc=xloc.bar_time, color=lineColor, width=lineWidth)

continuationLevel(float boundary, float breakoutPrice, bool upper) =>
    float remaining = continuationTicks * syminfo.mintick - math.abs(breakoutPrice - boundary)
    float candidate = math.round_to_mintick(breakoutPrice + (upper ? remaining / 2 : -remaining / 2))
    remaining > 0 and math.abs(candidate - breakoutPrice) >= syminfo.mintick ? candidate : na

// ─────────────────────────────────────────────────────────────
// 4. SESSION LOGIC
// ─────────────────────────────────────────────────────────────

processSession(
    bool enabled, string timezone, int startHour, int startMinute,
    int rangeMinutes, int extensionMinutes, color highColor,
    color lowColor, color breakHighColor, color breakLowColor,
    array<int> times, array<int> closes,
    array<float> highs, array<float> lows, array<float> prices) =>

    var float rangeHigh = na
    var float rangeLow = na
    var float upperTarget = na
    var float lowerTarget = na

    var bool rangeDrawn = false
    var bool upperBreakDrawn = false
    var bool lowerBreakDrawn = false
    var int lastProcessed = na
    var int lastSession = na
    var int rangeBars = 0

    bool upperSignal = false
    bool lowerSignal = false

    if enabled and array.size(times) > 0
        for i = 0 to array.size(times) - 1
            int barTime = array.get(times, i)
            int barClose = array.get(closes, i)
            float barHigh = array.get(highs, i)
            float barLow = array.get(lows, i)
            float barPrice = array.get(prices, i)

            if not na(barTime) and not na(barClose) and (na(lastProcessed) or barTime > lastProcessed)
                lastProcessed := barTime

                int startTime = timestamp(
                    timezone,
                    year(barTime, timezone),
                    month(barTime, timezone),
                    dayofmonth(barTime, timezone),
                    startHour, startMinute)

                int rangeEnd = startTime + rangeMinutes * 60000
                int sessionEnd = startTime + extensionMinutes * 60000

                bool inRange = barTime >= startTime and barClose <= rangeEnd
                bool inExtension = barTime >= rangeEnd and barClose <= sessionEnd

                if barTime >= startTime and (na(lastSession) or startTime != lastSession)
                    lastSession := startTime
                    rangeHigh := na
                    rangeLow := na
                    upperTarget := na
                    lowerTarget := na
                    rangeDrawn := false
                    upperBreakDrawn := false
                    lowerBreakDrawn := false
                    rangeBars := 0

                if inRange
                    rangeHigh := na(rangeHigh) ? barHigh : math.max(rangeHigh, barHigh)
                    rangeLow := na(rangeLow) ? barLow : math.min(rangeLow, barLow)
                    rangeBars += 1

                    if barClose == rangeEnd and rangeBars == rangeMinutes
                        drawLine(startTime, sessionEnd, rangeHigh, highColor)
                        drawLine(startTime, sessionEnd, rangeLow, lowColor)
                        rangeDrawn := true

                if rangeDrawn and inExtension
                    if not na(upperTarget) and barPrice >= upperTarget
                        drawLine(barClose, sessionEnd, upperTarget, upperContinuationColor)
                        upperTarget := na
                        upperSignal := true

                    if not na(lowerTarget) and barPrice <= lowerTarget
                        drawLine(barClose, sessionEnd, lowerTarget, lowerContinuationColor)
                        lowerTarget := na
                        lowerSignal := true

                    if not upperBreakDrawn and barPrice > rangeHigh
                        drawLine(barClose, sessionEnd, barPrice, breakHighColor)
                        upperTarget := continuationLevel(rangeHigh, barPrice, true)
                        upperBreakDrawn := true

                    if not lowerBreakDrawn and barPrice < rangeLow
                        drawLine(barClose, sessionEnd, barPrice, breakLowColor)
                        lowerTarget := continuationLevel(rangeLow, barPrice, false)
                        lowerBreakDrawn := true

    [upperSignal, lowerSignal]

// ─────────────────────────────────────────────────────────────
// 5. SESSION EXECUTION
// ─────────────────────────────────────────────────────────────

[minuteTimes, minuteCloses, minuteHighs, minuteLows, minutePrices] = request.security_lower_tf(
    syminfo.tickerid, "1",
    [time, time_close, high, low, close])

[minuteTime, minuteClose, minuteHigh, minuteLow, minutePrice] = request.security(
    syminfo.tickerid, "1",
    [time, time_close, high, low, close],
    lookahead=barmerge.lookahead_off)

bool subMinute = timeframe.in_seconds() < 60

array<int> times = minuteTimes
array<int> closes = minuteCloses
array<float> highs = minuteHighs
array<float> lows = minuteLows
array<float> prices = minutePrices

if subMinute
    times := array.new_int()
    closes := array.new_int()
    highs := array.new_float()
    lows := array.new_float()
    prices := array.new_float()

    if not na(minuteClose) and minuteClose <= time_close
        array.push(times, minuteTime)
        array.push(closes, minuteClose)
        array.push(highs, minuteHigh)
        array.push(lows, minuteLow)
        array.push(prices, minutePrice)

bool upperAlert = false
bool lowerAlert = false

if barstate.isconfirmed
    [nyUpper, nyLower] = processSession(
        nyEnabled, "America/New_York", nyHour, nyMinute,
        nyRange, nyExtension, nyHighColor, nyLowColor,
        nyBreakHighColor, nyBreakLowColor,
        times, closes, highs, lows, prices)

    [ldnUpper, ldnLower] = processSession(
        ldnEnabled, "Europe/London", ldnHour, ldnMinute,
        ldnRange, ldnExtension, ldnHighColor, ldnLowColor,
        ldnBreakHighColor, ldnBreakLowColor,
        times, closes, highs, lows, prices)

    [tkoUpper, tkoLower] = processSession(
        tkoEnabled, "Asia/Tokyo", tkoHour, tkoMinute,
        tkoRange, tkoExtension, tkoHighColor, tkoLowColor,
        tkoBreakHighColor, tkoBreakLowColor,
        times, closes, highs, lows, prices)

    upperAlert := nyUpper or ldnUpper or tkoUpper
    lowerAlert := nyLower or ldnLower or tkoLower

// ─────────────────────────────────────────────────────────────
// 6. ALERTS
// ─────────────────────────────────────────────────────────────

alertcondition(upperAlert, "Upper Continuation", "BUY {{ticker}}")
alertcondition(lowerAlert, "Lower Continuation", "SELL {{ticker}}")
