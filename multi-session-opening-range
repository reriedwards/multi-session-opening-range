//@version=6
indicator("Multi-Session Opening Range", overlay=true, max_lines_count=500)

// Global Settings
const string GLOBAL = "Global Settings"

lineWidth = input.int(1, "Line Thickness", minval=1, maxval=5, group=GLOBAL)
showOpeningRange = input.bool(true, "Show Opening Range Lines", group=GLOBAL)
openingRangeHighColor = input.color(#2196F3, "Opening Range High Color", group=GLOBAL)
openingRangeLowColor = input.color(#F23645, "Opening Range Low Color", group=GLOBAL)

// Half Range
const string HR = "Half Range"

halfRangeMode = input.string("Dynamic", "Half Range Mode", options=["Fixed", "Dynamic"], group=HR)

showUpperHalfRange = input.bool(true, "Show Upper Half Range", group=HR)
upperHalfRangeColor = input.color(#2196F3, "Upper Half Range Color", group=HR)

showLowerHalfRange = input.bool(true, "Show Lower Half Range", group=HR)
lowerHalfRangeColor = input.color(#F23645, "Lower Half Range Color", group=HR)

// New York Session
const string NY = "New York Session"

nyEnabled = input.bool(true, "Enable Session", group=NY)
nyHour = input.int(9, "Start Hour", minval=0, maxval=23, group=NY)
nyMinute = input.int(27, "Start Minute", minval=0, maxval=59, group=NY)
nyRange = input.int(3, "Opening Range (Minutes)", minval=1, group=NY)
nyExtension = input.int(392, "Extension Time (Minutes)", minval=1, group=NY)

// London Session
const string LDN = "London Session"

ldnEnabled = input.bool(false, "Enable Session", group=LDN)
ldnHour = input.int(8, "Start Hour", minval=0, maxval=23, group=LDN)
ldnMinute = input.int(27, "Start Minute", minval=0, maxval=59, group=LDN)
ldnRange = input.int(3, "Opening Range (Minutes)", minval=1, group=LDN)
ldnExtension = input.int(300, "Extension Time (Minutes)", minval=1, group=LDN)

// Tokyo Session
const string TKO = "Tokyo Session"

tkoEnabled = input.bool(true, "Enable Session", group=TKO)
tkoHour = input.int(8, "Start Hour", minval=0, maxval=23, group=TKO)
tkoMinute = input.int(57, "Start Minute", minval=0, maxval=59, group=TKO)
tkoRange = input.int(3, "Opening Range (Minutes)", minval=1, group=TKO)
tkoExtension = input.int(362, "Extension Time (Minutes)", minval=1, group=TKO)

// Drawing Helper
drawLine(int fromTime, int toTime, float price, color lineColor) =>
    line.new(
         fromTime, price, toTime, price,
         xloc=xloc.bar_time,
         color=lineColor,
         width=lineWidth)

// Session Logic
processSession(
     bool enabled, string timezone,
     int startHour, int startMinute,
     int rangeMinutes, int extensionMinutes,
     array<int> times, array<int> closeTimes,
     array<float> highs, array<float> lows,
     array<float> closePrices,
     int confirmedThrough) =>

    var float rangeHigh = na
    var float rangeLow = na
    var float upperHalfRange = na
    var float lowerHalfRange = na

    var bool rangeReady = false
    var bool upperDrawn = false
    var bool lowerDrawn = false

    var int lastSession = na
    var int lastProcessed = na
    var int rangeBars = 0

    if enabled and extensionMinutes > rangeMinutes and array.size(times) > 0
        for i = 0 to array.size(times) - 1
            int barTime = array.get(times, i)
            int barCloseTime = array.get(closeTimes, i)
            float barHigh = array.get(highs, i)
            float barLow = array.get(lows, i)
            float barClosePrice = array.get(closePrices, i)

            if not na(barTime) and not na(barCloseTime) and not na(barHigh) and not na(barLow) and not na(barClosePrice)
                int startTime = timestamp(
                     timezone,
                     year(barTime, timezone),
                     month(barTime, timezone),
                     dayofmonth(barTime, timezone),
                     startHour, startMinute)

                int rangeEnd = startTime + rangeMinutes * 60000
                int sessionEnd = startTime + extensionMinutes * 60000

                bool minuteConfirmed = barCloseTime <= confirmedThrough
                bool newMinute = na(lastProcessed) or barTime > lastProcessed

                if minuteConfirmed and newMinute
                    lastProcessed := barTime

                    if barTime >= startTime and (na(lastSession) or startTime != lastSession)
                        lastSession := startTime
                        rangeHigh := na
                        rangeLow := na
                        upperHalfRange := na
                        lowerHalfRange := na
                        rangeReady := false
                        upperDrawn := false
                        lowerDrawn := false
                        rangeBars := 0

                    if barTime >= startTime and barCloseTime <= rangeEnd
                        rangeHigh := na(rangeHigh) ? barHigh : math.max(rangeHigh, barHigh)
                        rangeLow := na(rangeLow) ? barLow : math.min(rangeLow, barLow)
                        rangeBars += 1

                        if not rangeReady and barCloseTime == rangeEnd and rangeBars == rangeMinutes
                            float halfRange = (rangeHigh - rangeLow) / 2.0

                            upperHalfRange := math.round_to_mintick(rangeHigh + halfRange)
                            lowerHalfRange := math.round_to_mintick(rangeLow - halfRange)
                            rangeReady := true

                            if showOpeningRange
                                drawLine(startTime, sessionEnd, rangeHigh, openingRangeHighColor)
                                drawLine(startTime, sessionEnd, rangeLow, openingRangeLowColor)

                            if halfRangeMode == "Fixed"
                                if showUpperHalfRange
                                    drawLine(startTime, sessionEnd, upperHalfRange, upperHalfRangeColor)
                                    upperDrawn := true

                                if showLowerHalfRange
                                    drawLine(startTime, sessionEnd, lowerHalfRange, lowerHalfRangeColor)
                                    lowerDrawn := true

                    if halfRangeMode == "Dynamic" and rangeReady and lastSession == startTime and barTime >= rangeEnd and barCloseTime < sessionEnd
                        if showUpperHalfRange and not upperDrawn and barClosePrice > upperHalfRange
                            drawLine(barCloseTime, sessionEnd, upperHalfRange, upperHalfRangeColor)
                            upperDrawn := true

                        if showLowerHalfRange and not lowerDrawn and barClosePrice < lowerHalfRange
                            drawLine(barCloseTime, sessionEnd, lowerHalfRange, lowerHalfRangeColor)
                            lowerDrawn := true

// One-Minute Data
[lowerTimes, lowerCloseTimes, lowerHighs, lowerLows, lowerClosePrices] = request.security_lower_tf(
     syminfo.tickerid, "1",
     [time, time_close, high, low, close],
     ignore_invalid_timeframe=true)

[previousTime, previousCloseTime, previousHigh, previousLow, previousClosePrice] = request.security(
     syminfo.tickerid, "1",
     [time[1], time_close[1], high[1], low[1], close[1]],
     lookahead=barmerge.lookahead_on)

[currentTime, currentCloseTime, currentHigh, currentLow, currentClosePrice] = request.security(
     syminfo.tickerid, "1",
     [time, time_close, high, low, close],
     lookahead=barmerge.lookahead_off)

int chartSeconds = timeframe.in_seconds()

array<int> times = lowerTimes
array<int> closeTimes = lowerCloseTimes
array<float> highs = lowerHighs
array<float> lows = lowerLows
array<float> closePrices = lowerClosePrices

int confirmedThrough = barstate.isconfirmed ? time_close : time

if chartSeconds > 60
    if not barstate.isconfirmed and array.size(times) > 0
        confirmedThrough := array.get(times, array.size(times) - 1)
else
    times := array.new_int()
    closeTimes := array.new_int()
    highs := array.new_float()
    lows := array.new_float()
    closePrices := array.new_float()

    if chartSeconds == 60
        array.push(times, time)
        array.push(closeTimes, time_close)
        array.push(highs, high)
        array.push(lows, low)
        array.push(closePrices, close)
    else
        if not na(previousTime)
            array.push(times, previousTime)
            array.push(closeTimes, previousCloseTime)
            array.push(highs, previousHigh)
            array.push(lows, previousLow)
            array.push(closePrices, previousClosePrice)

        if not na(currentTime) and currentTime <= time
            array.push(times, currentTime)
            array.push(closeTimes, currentCloseTime)
            array.push(highs, currentHigh)
            array.push(lows, currentLow)
            array.push(closePrices, currentClosePrice)

// Session Execution
processSession(
     nyEnabled, "America/New_York",
     nyHour, nyMinute, nyRange, nyExtension,
     times, closeTimes, highs, lows, closePrices,
     confirmedThrough)

processSession(
     ldnEnabled, "Europe/London",
     ldnHour, ldnMinute, ldnRange, ldnExtension,
     times, closeTimes, highs, lows, closePrices,
     confirmedThrough)

processSession(
     tkoEnabled, "Asia/Tokyo",
     tkoHour, tkoMinute, tkoRange, tkoExtension,
     times, closeTimes, highs, lows, closePrices,
     confirmedThrough)
