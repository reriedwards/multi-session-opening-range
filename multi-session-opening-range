// @version=6
indicator("Multi-Session Opening Range", overlay=true)

lineWidthInput = input.int(1, title="Line Thickness", minval=1, group="Global Settings")
showOriginalLines = input.bool(true, title="Show Original Opening Range Lines", group="Global Settings")

// --- New York Session Inputs ---
enableNY         = input.bool(true, title="Enable New York Session", group="New York Session")
nyStartHour      = input.int(9, title="Start Hour", minval=0, maxval=23, group="New York Session")
nyStartMin       = input.int(27, title="Start Minute", minval=0, maxval=59, group="New York Session")
nyRangeMinutes   = input.int(3, title="Opening Range (Minutes)", minval=1, group="New York Session")
nyExtendMinutes  = input.int(393, title="Extension Time (Minutes)", minval=1, group="New York Session")
nyHighColor      = input.color(color.blue, title="High Line Color", group="New York Session")
nyLowColor       = input.color(color.red, title="Low Line Color", group="New York Session")
nyBreakHighColor = input.color(color.blue, title="Upper Breakout Line Color", group="New York Session")
nyBreakLowColor  = input.color(color.red, title="Lower Breakout Line Color", group="New York Session")

// --- London Session Inputs ---
enableLDN         = input.bool(false, title="Enable London Session", group="London Session")
ldnStartHour      = input.int(3, title="Start Hour", minval=0, maxval=23, group="London Session")
ldnStartMin       = input.int(0, title="Start Minute", minval=0, maxval=59, group="London Session")
ldnRangeMinutes   = input.int(3, title="Opening Range (Minutes)", minval=1, group="London Session")
ldnExtendMinutes  = input.int(540, title="Extension Time (Minutes)", minval=1, group="London Session")
ldnHighColor      = input.color(color.blue, title="High Line Color", group="London Session")
ldnLowColor       = input.color(color.orange, title="Low Line Color", group="London Session")
ldnBreakHighColor = input.color(color.aqua, title="Upper Breakout Line Color", group="London Session")
ldnBreakLowColor  = input.color(color.yellow, title="Lower Breakout Line Color", group="London Session")

// --- Tokyo Session Inputs ---
enableTKO         = input.bool(true, title="Enable Tokyo Session", group="Tokyo Session")
tkoStartHour      = input.int(8, title="Start Hour", minval=0, maxval=23, group="Tokyo Session")
tkoStartMin       = input.int(3, title="Start Minute", minval=0, maxval=59, group="Tokyo Session")
tkoRangeMinutes   = input.int(57, title="Opening Range (Minutes)", minval=1, group="Tokyo Session")
tkoExtendMinutes  = input.int(362, title="Extension Time (Minutes)", minval=1, group="Tokyo Session")
tkoHighColor      = input.color(color.blue, title="High Line Color", group="Tokyo Session")
tkoLowColor       = input.color(color.red, title="Low Line Color", group="Tokyo Session")
tkoBreakHighColor = input.color(color.blue, title="Upper Breakout Line Color", group="Tokyo Session")
tkoBreakLowColor  = input.color(color.red, title="Lower Breakout Line Color", group="Tokyo Session")

// --- Opening Range Logic Function (Returns High/Low boundaries) ---
getOpeningRange(bool enabled, string tz, int startHour, int startMin, int rangeMins, int extendMins, color hiColor, color loColor, color breakHiColor, color breakLoColor, int thickness) =>
    var float maxHigh   = na
    var float minLow    = na
    var bool linesDrawn = false

    // Track only the first breakout per session
    var bool breakoutDrawn = false

    if enabled
        int currentYear  = year(time, tz)
        int currentMonth = month(time, tz)
        int currentDay   = dayofmonth(time, tz)

        int sessionStartMs = timestamp(tz, currentYear, currentMonth, currentDay, startHour, startMin, 0)
        int rangeEndMs     = sessionStartMs + (rangeMins * 60 * 1000)
        int extensionMs    = extendMins * 60 * 1000
        int futureTime     = sessionStartMs + extensionMs

        bool isNewSession = (time >= sessionStartMs) and (time[1] < sessionStartMs or na(time[1]))

        if isNewSession
            maxHigh    := high
            minLow     := low
            linesDrawn := false

            // Reset first breakout tracking
            breakoutDrawn := false

        else if (time >= sessionStartMs) and (time < rangeEndMs)
            maxHigh    := math.max(maxHigh, high)
            minLow     := math.min(minLow, low)

        bool timeWindowPassed = (time >= rangeEndMs) or (time + (timeframe.multiplier * 60 * 1000) > rangeEndMs)
        bool triggerDrawing   = timeWindowPassed and not linesDrawn and not na(maxHigh)

        if triggerDrawing
            if showOriginalLines
                line.new(x1=sessionStartMs, y1=maxHigh, x2=futureTime, y2=maxHigh, xloc=xloc.bar_time, color=hiColor, width=thickness)
                line.new(x1=sessionStartMs, y1=minLow, x2=futureTime, y2=minLow, xloc=xloc.bar_time, color=loColor, width=thickness)
            linesDrawn := true

        // Draw only the FIRST confirmed breakout per session
        if linesDrawn and time >= rangeEndMs and time < futureTime and barstate.isconfirmed and not breakoutDrawn
            // First close above original opening range high
            if close > maxHigh
                line.new(x1=time_close, y1=close, x2=futureTime, y2=close, xloc=xloc.bar_time, color=breakHiColor, width=thickness)
                breakoutDrawn := true

            // First close below original opening range low
            else if close < minLow
                line.new(x1=time_close, y1=close, x2=futureTime, y2=close, xloc=xloc.bar_time, color=breakLoColor, width=thickness)
                breakoutDrawn := true

        // Clear tracking values once past extension window limit to allow breakouts to reset safely
        if (time >= futureTime)
            maxHigh := na
            minLow := na

    [maxHigh, minLow]

// --- Execute Sessions and Capture Boundaries ---
[nyHigh, nyLow] = getOpeningRange(enableNY, "America/New_York", nyStartHour, nyStartMin, nyRangeMinutes, nyExtendMinutes, nyHighColor, nyLowColor, nyBreakHighColor, nyBreakLowColor, lineWidthInput)
[ldnHigh, ldnLow] = getOpeningRange(enableLDN, "Europe/London", ldnStartHour, ldnStartMin, ldnRangeMinutes, ldnExtendMinutes, ldnHighColor, ldnLowColor, ldnBreakHighColor, ldnBreakLowColor, lineWidthInput)
[tkoHigh, tkoLow] = getOpeningRange(enableTKO, "Asia/Tokyo", tkoStartHour, tkoStartMin, tkoRangeMinutes, tkoExtendMinutes, tkoHighColor, tkoLowColor, tkoBreakHighColor, tkoBreakLowColor, lineWidthInput)

// --- Global Breakout Detection Logic ---
bool alertHigh = false
bool alertLow  = false

// Check breaks against any active session parameters
if (enableNY and not na(nyHigh))
    alertHigh := alertHigh or ta.crossover(close, nyHigh)
    alertLow  := alertLow  or ta.crossunder(close, nyLow)

if (enableLDN and not na(ldnHigh))
    alertHigh := alertHigh or ta.crossover(close, ldnHigh)
    alertLow  := alertLow  or ta.crossunder(close, ldnLow)

if (enableTKO and not na(tkoHigh))
    alertHigh := alertHigh or ta.crossover(close, tkoHigh)
    alertLow  := alertLow  or ta.crossunder(close, tkoLow)

// --- Define TradingView UI Alerts ---
alertcondition(alertHigh, title="BUY", message="BUY")
alertcondition(alertLow,  title="SELL",  message="SELL")
